# Supabase → Project Settings → Database
#
# DATABASE_URL = Transaction pooler (port 6543). Used by the app on Vercel.
# DIRECT_URL   = Session pooler (port 5432 on pooler.supabase.com). Used by Prisma migrate.
# Do not use db.*.supabase.co on Vercel — that host is IPv6-only and the build cannot reach it.

DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

AARLA_AI_PROVIDER="mock"
# OPENAI_API_KEY=

# Local Postgres alternative (docker compose up -d):
# DATABASE_URL="postgresql://aarla:aarla@localhost:5432/aarla_xp"
# DIRECT_URL="postgresql://aarla:aarla@localhost:5432/aarla_xp"
